<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Cyber-Dash : Infinite Run</title>
    <style>
        :root {
            --bg-color: #0b0c10;
            --neon-cyan: #00f0ff;
            --neon-pink: #ff007f;
            --neon-green: #39ff14;
            --text-color: #e0e0e0;
            --font-main: 'Courier New', Courier, monospace;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-main);
            overflow: hidden; /* Empêche le scroll natif */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Container principal avec protection anti-swipe global */
        #game-container {
            position: relative;
            width: 100%;
            height: 100%;
            max-width: 1000px; /* Limite la largeur sur grand écran */
            max-height: 600px;
            background: #000;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.2);
            touch-action: none; /* Bloque le comportement tactile natif du navigateur */
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        /* UI Overlays */
        #ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none; /* Laisse passer les clics vers le canvas */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
            box-sizing: border-box;
        }

        .score-board {
            display: flex;
            justify-content: space-between;
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--neon-cyan);
            text-shadow: 0 0 10px var(--neon-cyan);
        }

        #menu-screen {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: auto;
            background: rgba(11, 12, 16, 0.9);
            padding: 30px;
            border: 2px solid var(--neon-pink);
            box-shadow: 0 0 15px var(--neon-pink);
            border-radius: 10px;
        }

        h1 {
            margin-top: 0;
            color: var(--neon-pink);
            text-shadow: 0 0 10px var(--neon-pink);
            text-transform: uppercase;
            font-size: 2.5rem;
        }

        button {
            background: transparent;
            border: 2px solid var(--neon-cyan);
            color: var(--neon-cyan);
            padding: 15px 30px;
            font-size: 1.2rem;
            font-family: inherit;
            text-transform: uppercase;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            outline: none;
        }

        button:hover {
            background: var(--neon-cyan);
            color: var(--bg-color);
            box-shadow: 0 0 15px var(--neon-cyan);
        }
    </style>
</head>
<body>

    <!-- Placeholder pour simuler ton script de Hub Global -->
    <script>
        document.addEventListener('touchstart', (e) => {
            if(e.target.closest('.no-swipe')) { e.stopPropagation(); }
        });
        document.addEventListener('mousedown', (e) => {
            if(e.target.closest('.no-swipe')) { e.stopPropagation(); }
        });
    </script>

    <div id="game-container" class="no-swipe">
        <canvas id="gameCanvas"></canvas>
        
        <div id="ui-layer">
            <div class="score-board">
                <div>SCORE: <span id="score">0</span></div>
                <div>HI: <span id="hi-score">0</span></div>
            </div>
        </div>

        <div id="menu-screen">
            <h1 id="menu-title">Cyber-Dash</h1>
            <p id="menu-desc" style="color: var(--text-color); margin-bottom: 20px;">
                Espace, Clic ou Tap pour sauter.<br>Survis à l'Overdrive.
            </p>
            <button id="start-btn">Système Start</button>
        </div>
    </div>

    <script>
        // --- SETUP CANVAS & VARIABLES ---
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');
        const hiScoreEl = document.getElementById('hi-score');
        const menuScreen = document.getElementById('menu-screen');
        const startBtn = document.getElementById('start-btn');
        const menuTitle = document.getElementById('menu-title');

        let width, height;
        
        // États du jeu
        let gameState = 'START'; // START, PLAYING, GAMEOVER
        let score = 0;
        let hiScore = localStorage.getItem('cyberDashHiScore') || 0;
        hiScoreEl.innerText = Math.floor(hiScore);
        
        // Physique globale
        let gameSpeed = 6;
        const GRAVITY = 0.8;
        const GROUND_HEIGHT = 100; // Hauteur du sol par rapport au bas

        // Joueur (Le Cube)
        const player = {
            x: 100,
            y: 0,
            size: 40,
            vy: 0,
            jumpPower: -14,
            isGrounded: false,
            rotation: 0,
            trail: [] // Pour l'effet néon
        };

        // Obstacles
        let obstacles = [];
        let spawnTimer = 0;

        // Particules (Parallax)
        let bgGridX = 0;

        // --- INITIALISATION & RESIZE ---
        function resize() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
            width = canvas.width;
            height = canvas.height;
            if(gameState === 'START') player.y = height - GROUND_HEIGHT - player.size;
        }
        window.addEventListener('resize', resize);
        resize();

        // --- INPUTS ---
        function handleInput(e) {
            if (e.type !== 'keydown') e.preventDefault(); // Evite le double trigger touch/click
            if (e.type === 'keydown' && e.code !== 'Space' && e.code !== 'ArrowUp') return;

            if (gameState === 'PLAYING') {
                if (player.isGrounded) {
                    player.vy = player.jumpPower;
                    player.isGrounded = false;
                }
            } else if (gameState === 'GAMEOVER') {
                resetGame();
            }
        }

        window.addEventListener('keydown', handleInput);
        canvas.addEventListener('mousedown', handleInput);
        canvas.addEventListener('touchstart', handleInput, {passive: false});

        startBtn.addEventListener('click', () => {
            if(gameState === 'START' || gameState === 'GAMEOVER') resetGame();
        });

        // --- LOGIQUE DE JEU ---
        function resetGame() {
            player.y = height - GROUND_HEIGHT - player.size;
            player.vy = 0;
            player.rotation = 0;
            player.trail = [];
            obstacles = [];
            score = 0;
            gameSpeed = 7; // Vitesse initiale
            spawnTimer = 0;
            gameState = 'PLAYING';
            menuScreen.style.display = 'none';
            loop();
        }

        function spawnObstacle() {
            // Types d'obstacles : Spike (Triangle), Bloc (Carré)
            const type = Math.random() > 0.3 ? 'spike' : 'block';
            
            // On peut créer des groupes d'obstacles
            const size = 40;
            obstacles.push({
                x: width,
                y: height - GROUND_HEIGHT - size,
                size: size,
                type: type,
                passed: false
            });
        }

        function gameOver() {
            gameState = 'GAMEOVER';
            menuScreen.style.display = 'block';
            menuTitle.innerText = "CRASH SYSTÈME";
            menuTitle.style.color = "red";
            startBtn.innerText = "Reboot";
            
            if (score > hiScore) {
                hiScore = score;
                localStorage.setItem('cyberDashHiScore', hiScore);
                hiScoreEl.innerText = Math.floor(hiScore);
            }
        }

        // --- HITBOXES ET COLLISIONS ---
        function checkCollision(rect1, obs) {
            // Pour être moins frustrant, on réduit légèrement la hitbox réelle (pardonne les pixels)
            const tolerance = 5; 
            
            let hitX = (rect1.x + tolerance < obs.x + obs.size) && (rect1.x + rect1.size - tolerance > obs.x);
            let hitY = false;

            if (obs.type === 'block') {
                hitY = (rect1.y + tolerance < obs.y + obs.size) && (rect1.y + rect1.size - tolerance > obs.y);
            } else if (obs.type === 'spike') {
                // Collision simplifiée pour le spike (on considère un petit rectangle au centre bas)
                hitY = (rect1.y + rect1.size - tolerance > obs.y + obs.size/2); // Touche le bas
                // On pourrait faire du vrai SAT (Separating Axis Theorem), mais un AABB permissif suffit pour un runner web
            }

            return hitX && hitY;
        }

        // --- BOUCLE PRINCIPALE ---
        function update() {
            if (gameState !== 'PLAYING') return;

            // 1. Vitesse et Score
            gameSpeed += 0.002; // Accélération progressive
            score += gameSpeed * 0.05;
            scoreEl.innerText = Math.floor(score);

            // 2. Parallax (Grille de fond)
            bgGridX -= gameSpeed * 0.5;
            if (bgGridX <= -40) bgGridX = 0;

            // 3. Physique du joueur
            player.vy += GRAVITY;
            player.y += player.vy;

            // Enregistrement de la trail
            player.trail.push({x: player.x, y: player.y});
            if (player.trail.length > 10) player.trail.shift();

            // Sol
            const groundLevel = height - GROUND_HEIGHT - player.size;
            if (player.y >= groundLevel) {
                player.y = groundLevel;
                player.vy = 0;
                player.isGrounded = true;
                
                // Snap de la rotation (Geometry Dash style : on s'aligne à 90°)
                let mod = player.rotation % (Math.PI/2);
                if (mod > 0.1) {
                    player.rotation += (Math.PI/2 - mod); 
                } else {
                    player.rotation = Math.round(player.rotation / (Math.PI/2)) * (Math.PI/2);
                }
            } else {
                // Tourne en l'air
                player.rotation += 0.1;
            }

            // 4. Gestion des Obstacles
            spawnTimer -= gameSpeed;
            if (spawnTimer <= 0) {
                spawnObstacle();
                // Randomiser le temps d'apparition en fonction de la vitesse pour que ça reste faisable
                spawnTimer = Math.random() * 200 + (3000 / gameSpeed); 
            }

            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.x -= gameSpeed;

                // Collision
                if (checkCollision(player, obs)) {
                    gameOver();
                    return; // Stoppe l'update direct
                }

                if (obs.x + obs.size < 0) {
                    obstacles.splice(i, 1);
                }
            }
        }

        function draw() {
            // Effacer l'écran (avec légère opacité pour un mini effet de flou de mouvement sur le fond)
            ctx.fillStyle = 'rgba(11, 12, 16, 1)'; 
            ctx.fillRect(0, 0, width, height);

            if (gameState === 'START') return;

            // --- FOND (Grille Parallax Cyberpunk) ---
            ctx.strokeStyle = 'rgba(0, 240, 255, 0.1)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            // Lignes verticales
            for(let x = bgGridX; x < width; x += 40) {
                ctx.moveTo(x, 0); ctx.lineTo(x, height);
            }
            // Lignes horizontales
            for(let y = 0; y < height; y += 40) {
                ctx.moveTo(0, y); ctx.lineTo(width, y);
            }
            ctx.stroke();

            // --- LE SOL ---
            const groundY = height - GROUND_HEIGHT;
            ctx.fillStyle = '#111';
            ctx.fillRect(0, groundY, width, GROUND_HEIGHT);
            
            // Ligne de néon sur le sol
            ctx.shadowBlur = 10;
            ctx.shadowColor = 'var(--neon-pink)';
            ctx.strokeStyle = '#ff007f';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(0, groundY);
            ctx.lineTo(width, groundY);
            ctx.stroke();
            ctx.shadowBlur = 0; // Reset shadow

            // --- TRAIL (Traînée du joueur) ---
            player.trail.forEach((pos, index) => {
                const alpha = index / player.trail.length;
                ctx.fillStyle = `rgba(0, 240, 255, ${alpha * 0.5})`;
                ctx.fillRect(pos.x, pos.y, player.size, player.size);
            });

            // --- JOUEUR (Le Cube) ---
            ctx.save();
            ctx.translate(player.x + player.size/2, player.y + player.size/2);
            ctx.rotate(player.rotation);
            
            ctx.shadowBlur = 15;
            ctx.shadowColor = 'var(--neon-cyan)';
            ctx.fillStyle = '#0b0c10'; // Interieur sombre
            ctx.fillRect(-player.size/2, -player.size/2, player.size, player.size);
            
            ctx.strokeStyle = '#00f0ff'; // Bordure Cyan
            ctx.lineWidth = 3;
            ctx.strokeRect(-player.size/2, -player.size/2, player.size, player.size);
            ctx.restore();

            // --- OBSTACLES ---
            ctx.shadowBlur = 10;
            ctx.shadowColor = 'var(--neon-pink)';
            ctx.fillStyle = '#ff007f';
            
            obstacles.forEach(obs => {
                if (obs.type === 'block') {
                    // Caisse basique
                    ctx.fillRect(obs.x, obs.y, obs.size, obs.size);
                    ctx.strokeStyle = '#fff';
                    ctx.strokeRect(obs.x, obs.y, obs.size, obs.size);
                } else if (obs.type === 'spike') {
                    // Triangle pointe vers le haut
                    ctx.beginPath();
                    ctx.moveTo(obs.x + obs.size/2, obs.y); // Pointe haut
                    ctx.lineTo(obs.x + obs.size, obs.y + obs.size); // Coin bas droit
                    ctx.lineTo(obs.x, obs.y + obs.size); // Coin bas gauche
                    ctx.closePath();
                    ctx.fill();
                    ctx.stroke();
                }
            });
            ctx.shadowBlur = 0; // Reset
        }

        // --- LANCEMENT DE LA BOUCLE ---
        function loop() {
            update();
            draw();
            if (gameState !== 'START') { // Ne boucle que si on a passé l'écran d'accueil
                requestAnimationFrame(loop);
            }
        }
        
        // Un premier draw pour afficher le menu proprement
        draw(); 

    </script>
</body>
</html>
