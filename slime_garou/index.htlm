<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Slime-Garou : Infection Protocol</title>
    <script src="https://unpkg.com/peerjs@1.4.7/dist/peerjs.min.js"></script>
    <style>
        :root {
            --bg-color: #0b0c10;
            --neon-cyan: #00f0ff;
            --neon-pink: #ff007f;
            --neon-green: #39ff14;
            --neon-yellow: #fce803;
            --text-color: #e0e0e0;
            --font-main: 'Courier New', Courier, monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-main);
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            text-align: center;
            padding: 20px;
            box-sizing: border-box;
        }

        h1, h2 {
            color: var(--neon-cyan);
            text-shadow: 0 0 10px var(--neon-cyan);
            text-transform: uppercase;
        }

        .container {
            background: rgba(0, 0, 0, 0.8);
            border: 2px solid var(--neon-pink);
            box-shadow: 0 0 15px var(--neon-pink);
            padding: 20px;
            border-radius: 10px;
            width: 100%;
            max-width: 600px;
            margin-bottom: 20px;
        }

        /* Classes pour exclure le swipe global de la plateforme */
        .no-swipe { touch-action: none; }

        input[type="text"], input[type="number"], button {
            background: transparent;
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
            padding: 10px;
            margin: 10px 0;
            width: 100%;
            box-sizing: border-box;
            font-family: inherit;
            font-size: 16px;
            outline: none;
            transition: 0.3s;
        }

        input:focus { box-shadow: 0 0 10px var(--neon-cyan); }

        button {
            cursor: pointer;
            text-transform: uppercase;
            font-weight: bold;
        }
        button:hover {
            background: var(--neon-cyan);
            color: var(--bg-color);
        }

        .btn-host { border-color: var(--neon-pink); color: var(--neon-pink); }
        .btn-host:hover { background: var(--neon-pink); }

        .btn-start { border-color: var(--neon-green); color: var(--neon-green); display: none;}
        .btn-start:hover { background: var(--neon-green); }

        /* Configuration area */
        .config-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            text-align: left;
            margin: 15px 0;
            padding: 15px;
            border: 1px dashed var(--neon-yellow);
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        input[type="checkbox"] {
            accent-color: var(--neon-pink);
            width: 20px;
            height: 20px;
        }

        /* In-Game UI */
        #game-area { display: none; }
        .role-card {
            border: 2px solid var(--neon-cyan);
            padding: 20px;
            margin: 20px 0;
            box-shadow: 0 0 20px var(--neon-cyan);
            background: #111;
        }
        
        .role-img {
            max-width: 150px;
            display: block;
            margin: 0 auto 15px;
            filter: drop-shadow(0 0 10px var(--neon-cyan));
        }

        .player-list { list-style: none; padding: 0; text-align: left; }
        .player-list li { margin: 5px 0; padding: 5px; border-bottom: 1px solid #333; }
        
        .sys-log {
            font-size: 0.9em;
            color: var(--neon-green);
            background: #000;
            padding: 10px;
            border-radius: 5px;
            height: 100px;
            overflow-y: auto;
            text-align: left;
            border: 1px solid var(--neon-green);
        }
    </style>
</head>
<body>

    <!-- Placeholder pour le script de Swipe Global du Hub -->
    <script>
        // Ce script représente la logique globale du hub pour swipe entre les jeux.
        // On s'assure qu'il ignore les éléments avec la classe .no-swipe
        document.addEventListener('touchstart', (e) => {
            if(e.target.closest('.no-swipe')) {
                e.stopPropagation(); // Bloque le swipe global ici
            }
        });
    </script>

    <div class="container no-swipe">
        <h1>Slime-Garou</h1>
        
        <!-- MENU PRINCIPAL -->
        <div id="menu">
            <button id="btn-create" class="btn-host">Créer un Serveur (Hôte)</button>
            <hr style="border-color: #333; margin: 20px 0;">
            <input type="text" id="join-id" placeholder="ID de Connexion">
            <input type="text" id="player-name" placeholder="Ton Pseudo Cyber">
            <button id="btn-join">Rejoindre la Partie</button>
        </div>

        <!-- LOBBY & CONFIGURATION (Réservé à l'hôte ou affichage pour clients) -->
        <div id="lobby" style="display: none;">
            <h2>Réseau Local</h2>
            <p>ID Hôte : <span id="my-id" style="color: var(--neon-pink); font-weight: bold; user-select: all;">Génération...</span></p>
            
            <div id="host-config" style="display: none;">
                <h3>Configuration de la Partie</h3>
                <div class="config-grid">
                    <div>
                        <label>Nb. Slime-Garous :</label>
                        <input type="number" id="cfg-wolves" value="1" min="1" max="3" style="width: 50px;">
                    </div>
                    <div class="checkbox-group">
                        <label>Slime Voyante</label>
                        <input type="checkbox" id="cfg-seer" checked>
                    </div>
                    <div class="checkbox-group">
                        <label>Slime Sorcière</label>
                        <input type="checkbox" id="cfg-witch" checked>
                    </div>
                    <div class="checkbox-group">
                        <label>Slime Chasseur</label>
                        <input type="checkbox" id="cfg-hunter">
                    </div>
                </div>
            </div>

            <h3>Joueurs Connectés (<span id="player-count">1</span>)</h3>
            <ul id="players-list" class="player-list"></ul>
            
            <button id="btn-start" class="btn-start">Initialiser le Protocole (Lancer)</button>
        </div>

        <!-- ZONE DE JEU -->
        <div id="game-area" class="no-swipe">
            <h2 id="phase-title">Phase : Chargement...</h2>
            
            <div class="role-card" id="my-role-card">
                <img id="role-image" class="role-img" src="slime.png" alt="Role Image">
                <h3 id="role-name" style="margin:0;">En attente de rôle</h3>
                <p id="role-desc" style="font-size: 0.9em; color: gray;">...</p>
            </div>

            <h3>Interface de Scan</h3>
            <!-- Liste dynamique pour les votes / actions de nuit -->
            <div id="action-panel" style="margin-bottom: 20px;">
                <p style="color:var(--neon-yellow);">En attente des ordres du système...</p>
            </div>

            <h3>Logs Système</h3>
            <div class="sys-log" id="sys-log">
                > Connexion établie...
            </div>
        </div>
    </div>

    <script>
        // --- VARIABLES GLOBALES ---
        let peer = null;
        let connections = []; // Array d'objets { conn, name, role, isAlive, id }
        let isHost = false;
        let myName = "Hôte";
        let myRole = "";

        // Elements DOM
        const menuDiv = document.getElementById('menu');
        const lobbyDiv = document.getElementById('lobby');
        const gameArea = document.getElementById('game-area');
        const logArea = document.getElementById('sys-log');

        function addLog(msg) {
            logArea.innerHTML += `<br>> ${msg}`;
            logArea.scrollTop = logArea.scrollHeight;
        }

        // --- INIT PEER ---
        function initPeer(callback) {
            peer = new Peer();
            peer.on('open', (id) => {
                if(callback) callback(id);
            });
            peer.on('error', (err) => {
                alert("Erreur Réseau : " + err);
            });
        }

        // --- HÔTE : CRÉATION ---
        document.getElementById('btn-create').addEventListener('click', () => {
            isHost = true;
            menuDiv.style.display = 'none';
            lobbyDiv.style.display = 'block';
            document.getElementById('host-config').style.display = 'block';
            
            // L'hôte est le 1er joueur
            connections.push({ isHost: true, name: "Hôte (Toi)", role: null, isAlive: true });
            updatePlayerListUI();

            initPeer((id) => {
                document.getElementById('my-id').innerText = id;
            });

            // Gérer les connexions entrantes
            peer.on('connection', (conn) => {
                conn.on('open', () => {
                    // On attend que le client envoie son pseudo
                });
                
                conn.on('data', (data) => {
                    if (data.type === 'join') {
                        connections.push({ conn: conn, name: data.name, role: null, isAlive: true, id: conn.peer });
                        updatePlayerListUI();
                        // Broadcast de la nouvelle liste à tous les clients
                        broadcast({ type: 'lobby_update', count: connections.length, list: connections.map(c => c.name) });
                        
                        if (connections.length >= 3) { // Min 3 joueurs pour tester
                            document.getElementById('btn-start').style.display = 'block';
                        }
                    }
                });
            });
        });

        // --- CLIENT : REJOINDRE ---
        document.getElementById('btn-join').addEventListener('click', () => {
            const hostId = document.getElementById('join-id').value.trim();
            myName = document.getElementById('player-name').value.trim() || "Anonyme_" + Math.floor(Math.random()*1000);
            if(!hostId) return alert("ID Requis");

            menuDiv.style.display = 'none';
            lobbyDiv.style.display = 'block';
            document.getElementById('my-id').parentElement.style.display = 'none'; // Cacher l'ID de l'hôte pour le client

            initPeer(() => {
                const conn = peer.connect(hostId);
                conn.on('open', () => {
                    conn.send({ type: 'join', name: myName });
                });

                conn.on('data', (data) => {
                    if (data.type === 'lobby_update') {
                        document.getElementById('player-count').innerText = data.count;
                        const list = document.getElementById('players-list');
                        list.innerHTML = "";
                        data.list.forEach(name => {
                            list.innerHTML += `<li>${name}</li>`;
                        });
                    }
                    else if (data.type === 'game_start') {
                        lobbyDiv.style.display = 'none';
                        gameArea.style.display = 'block';
                        setupRoleUI(data.role);
                        addLog("La partie commence. Nuit en approche...");
                    }
                });
            });
        });

        function broadcast(data) {
            connections.forEach(c => {
                if(!c.isHost && c.conn) c.conn.send(data);
            });
        }

        function updatePlayerListUI() {
            document.getElementById('player-count').innerText = connections.length;
            const list = document.getElementById('players-list');
            list.innerHTML = "";
            connections.forEach(c => {
                list.innerHTML += `<li>${c.name}</li>`;
            });
        }

        // --- HÔTE : DISTRIBUTION DES RÔLES ---
        document.getElementById('btn-start').addEventListener('click', () => {
            const numPlayers = connections.length;
            const nbWolves = parseInt(document.getElementById('cfg-wolves').value);
            const hasSeer = document.getElementById('cfg-seer').checked;
            const hasWitch = document.getElementById('cfg-witch').checked;
            const hasHunter = document.getElementById('cfg-hunter').checked;

            let roles = [];
            for(let i = 0; i < nbWolves; i++) roles.push('slimegarou');
            if (hasSeer) roles.push('voyante');
            if (hasWitch) roles.push('sorciere');
            if (hasHunter) roles.push('chasseur');
            
            // Remplir le reste avec des slimes normaux
            while(roles.length < numPlayers) {
                roles.push('slime');
            }

            // Vérifier si la config est valide
            if(roles.length > numPlayers) {
                alert("Trop de rôles spéciaux pour le nombre de joueurs !");
                return;
            }

            // Mélanger (Fisher-Yates)
            for (let i = roles.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [roles[i], roles[j]] = [roles[j], roles[i]];
            }

            // Assigner
            connections.forEach((c, index) => {
                c.role = roles[index];
                if(c.isHost) {
                    lobbyDiv.style.display = 'none';
                    gameArea.style.display = 'block';
                    setupRoleUI(c.role);
                    addLog("La partie commence. Tu es l'hôte.");
                } else {
                    c.conn.send({ type: 'game_start', role: c.role });
                }
            });

            // Lancer la State Machine (Nuit 1)
            // setTimeout(() => startNightPhase(), 3000); 
            // C'est ici que tu appelleras la fonction de boucle de jeu
        });

        // --- INTERFACE DE JEU ---
        function setupRoleUI(role) {
            myRole = role;
            const roleNameEl = document.getElementById('role-name');
            const roleDescEl = document.getElementById('role-desc');
            const roleImgEl = document.getElementById('role-image');
            const cardEl = document.getElementById('my-role-card');

            // Assets selon le rôle (utiliser tes .png)
            let color = "";
            switch(role) {
                case 'slimegarou':
                    roleNameEl.innerText = "Slime-Garou";
                    roleDescEl.innerText = "Chaque nuit, dévore un Slime avec la meute.";
                    roleImgEl.src = "slimegarou.png";
                    color = "var(--neon-pink)";
                    break;
                case 'voyante':
                    roleNameEl.innerText = "Slime Voyante";
                    roleDescEl.innerText = "Chaque nuit, scanne l'identité d'un joueur.";
                    roleImgEl.src = "voyante.png";
                    color = "var(--neon-cyan)";
                    break;
                case 'sorciere':
                    roleNameEl.innerText = "Slime Sorcière";
                    roleDescEl.innerText = "Tu as une potion de soin et une potion de poison (1 usage chaque).";
                    roleImgEl.src = "sorciere.png";
                    color = "#9b59b6"; // Violet
                    break;
                case 'chasseur':
                    roleNameEl.innerText = "Slime Chasseur";
                    roleDescEl.innerText = "Si tu es éliminé, tu tires avec ton laser sur un joueur avant de mourir.";
                    roleImgEl.src = "chasseur.png";
                    color = "var(--neon-yellow)";
                    break;
                default:
                    roleNameEl.innerText = "Slime (Civil)";
                    roleDescEl.innerText = "Survis. Trouve les infectés le jour.";
                    roleImgEl.src = "slime.png";
                    color = "var(--neon-green)";
                    break;
            }
            
            cardEl.style.borderColor = color;
            cardEl.style.boxShadow = `0 0 20px ${color}`;
            roleNameEl.style.color = color;
        }
    </script>
    // ==========================================
        // 🌑 MOTEUR MULTIJOUEUR : CYCLE JOUR / NUIT
        // ==========================================

        let gameState = {
            phase: 'lobby', // lobby, night_wolves, night_seer, night_witch, day_vote
            votes: {},      // Stocke les votes en cours
            deadTonight: [] // Victimes de la nuit
        };

        // --- HÔTE : GESTION DES PHASES ---
        
        function startNightPhase() {
            gameState.phase = 'night_wolves';
            gameState.votes = {};
            addLog("Système en veille... Les Slime-Garous se réveillent.");
            
            // On demande à tous les clients de mettre à jour leur UI
            broadcast({ type: 'phase_change', phase: 'night_wolves', message: 'Nuit : Les infectés choisissent leur cible.' });
            
            // L'hôte met aussi à jour sa propre UI
            updateClientUI('night_wolves', 'Nuit : Les infectés choisissent leur cible.');
        }

        // L'hôte reçoit les actions réseau des joueurs
        function handleNetworkAction(clientId, data) {
            if (data.type === 'action') {
                if (gameState.phase === 'night_wolves' && data.role === 'slimegarou') {
                    gameState.votes[clientId] = data.target;
                    checkWolvesVotes();
                }
                // Ici on ajoutera la voyante, la sorcière, etc.
            }
        }

        function checkWolvesVotes() {
            const aliveWolves = connections.filter(c => c.role === 'slimegarou' && c.isAlive);
            const votesCount = Object.keys(gameState.votes).length;

            if (votesCount === aliveWolves.length) {
                // Tous les loups ont voté ! On détermine la cible (simplifié : on prend le 1er vote unanime)
                const targetId = Object.values(gameState.votes)[0]; 
                const victim = connections.find(c => c.name === targetId);
                
                if(victim) {
                    victim.isAlive = false;
                    gameState.deadTonight.push(victim.name);
                }
                
                // Passage à la phase suivante (ex: Le Jour)
                setTimeout(() => startDayPhase(), 2000);
            }
        }

        function startDayPhase() {
            gameState.phase = 'day_vote';
            let msg = `Le jour se lève. Code mort : ${gameState.deadTonight.join(', ') || 'Aucun'}.`;
            addLog(msg);
            
            broadcast({ type: 'phase_change', phase: 'day_vote', message: msg });
            updateClientUI('day_vote', msg);
            gameState.deadTonight = []; // Reset
        }

        // --- CLIENT : MISE À JOUR DE L'INTERFACE ---

        function updateClientUI(phase, message) {
            document.getElementById('phase-title').innerText = message;
            const actionPanel = document.getElementById('action-panel');
            actionPanel.innerHTML = ''; // On vide le panel

            // Si c'est la nuit et que je suis Slime-Garou
            if (phase === 'night_wolves' && myRole === 'slimegarou') {
                actionPanel.innerHTML = `<p style="color:var(--neon-pink);">Choisis un Slime à infecter :</p>`;
                
                // Afficher des boutons pour chaque joueur en vie
                connections.forEach(c => {
                    if (c.name !== myName && c.isAlive) {
                        let btn = document.createElement('button');
                        btn.innerText = `[Tuer] ${c.name}`;
                        btn.style.borderColor = "var(--neon-pink)";
                        btn.onclick = () => sendActionToServer('kill', c.name);
                        actionPanel.appendChild(btn);
                    }
                });
            } 
            // Si c'est la nuit et que je suis un civil
            else if (phase.startsWith('night') && myRole !== 'slimegarou') {
                actionPanel.innerHTML = `<p style="color:gray;">Ferme les yeux, ton système est en veille...</p>`;
            }
            // Si c'est le jour, tout le monde peut voter pour éliminer
            else if (phase === 'day_vote') {
                actionPanel.innerHTML = `<p style="color:var(--neon-yellow);">Vote pour déconnecter un suspect :</p>`;
                // ... logique des boutons de vote de jour
            }
        }

        // Fonction pour que le client envoie son choix à l'Hôte
        function sendActionToServer(actionType, targetName) {
            const data = { type: 'action', role: myRole, action: actionType, target: targetName };
            
            if (isHost) {
                // L'hôte s'envoie la donnée à lui-même
                handleNetworkAction(myName, data);
                document.getElementById('action-panel').innerHTML = "<p>Donnée transmise. En attente des autres...</p>";
            } else {
                // Le client envoie à l'Hôte via PeerJS
                connections[0].conn.send(data);
                document.getElementById('action-panel').innerHTML = "<p>Donnée transmise au serveur. En attente...</p>";
            }
        }

        // N'oublie pas de modifier la réception de données chez l'Hôte (dans btn-create)
        // pour écouter "handleNetworkAction(conn.peer, data);" quand il reçoit un {type: 'action'}
</body>
</html>
